{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Doomer text reel",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "text", "background_image", "source_url", "source_file", "source_title", "source_type", "source_locator", "sort_order", "language"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]{3,}$" },
    "title": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1 },
    "background_image": { "type": "string", "pattern": "^images/[A-Za-z0-9_-]+\\.(svg|png|jpe?g|webp)$" },
    "source_url": { "type": ["string", "null"], "pattern": "^https?://[^\\s]+$" },
    "source_file": { "enum": [null, "source/original.pdf"] },
    "source_title": { "type": "string", "minLength": 1 },
    "source_type": { "enum": ["article", "video", "pdf"] },
    "source_locator": { "type": "string", "minLength": 1 },
    "sort_order": { "type": "integer", "minimum": 1 },
    "language": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" }
  },
  "anyOf": [
    { "properties": { "source_url": { "type": "string" } } },
    { "properties": { "source_type": { "const": "pdf" }, "source_file": { "type": "string" } } }
  ]
}

# LOCAL: start via ./scripts/dev.sh. Production values belong in your hosting dashboard.
DOOMER_ENVIRONMENT=development
DOOMER_AUTH_MODE=local
# Leave unset locally to use data/doomer.db. NEVER deploy with SQLite on an ephemeral host.
# DOOMER_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@POOLER:5432/postgres?sslmode=require
# Production: set environment=production and auth_mode=supabase.
DOOMER_OWNER_EMAIL=
DOOMER_SUPABASE_URL=
DOOMER_SUPABASE_PUBLISHABLE_KEY=
# Render automatically allows RENDER_EXTERNAL_HOSTNAME. Add custom domains here if needed.
DOOMER_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional error tracking. Backend and browser should use separate Sentry projects.
DOOMER_SENTRY_DSN=
DOOMER_FRONTEND_SENTRY_DSN=
DOOMER_RELEASE=local

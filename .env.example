# LOCAL: start with sh scripts/dev.sh. Hosted secrets belong in Render.
DOOMER_ENVIRONMENT=development
DOOMER_AUTH_MODE=local
# Set auth_mode=email to test the email-only profile form locally.
# Production: environment=production, auth_mode=email, and a PostgreSQL URL.
# DOOMER_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DOOMER_OWNER_EMAIL=
# Render automatically allows its own hostname. Add custom domains if needed.
DOOMER_ALLOWED_HOSTS=localhost,127.0.0.1
DOOMER_SENTRY_DSN=
DOOMER_FRONTEND_SENTRY_DSN=
DOOMER_RELEASE=local
